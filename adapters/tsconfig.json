{
  "extends": "../tsconfig.build.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "jsx": "react-jsx",
    "jsxImportSource": "#jsx",
    "declaration": false,
    "declarationMap": false
  },
  "include": [
    "jsx/**/*.ts",
    "jsx/**/*.tsx",
    "vue/**/*.ts",
    "scene/**/*.ts",
    "scene/**/*.tsx",
    "base-ui/**/*.ts",
    "base-ui/**/*.tsx"
  ]
}
